(defpackage #:almighty-settei/t/kinds
  (:use #:cl #:lisp-unit2)
  (:local-nicknames (#:settei #:almighty-settei)))

(in-package #:almighty-settei/t/kinds)

(defun make (kind &rest options)
  (apply #'make-instance kind :name :t/example options))

(defun accept (setting value)
  (settei:accept-value setting value nil))

(define-test boolean-from-words ()
  (let ((setting (make 'settei:boolean-setting)))
    (dolist (word '("true" "TRUE" "yes" "on" "1" " true "))
      (assert-eq t (accept setting word) word))
    (dolist (word '("false" "No" "off" "0"))
      (assert-eq nil (accept setting word) word))
    (assert-eq t (accept setting t))
    (assert-error 'settei:setting-invalid (accept setting "maybe"))
    (assert-error 'settei:setting-invalid (accept setting 1))))

(define-test integer-from-strings ()
  (let ((setting (make 'settei:integer-setting)))
    (assert-eql 5000 (accept setting "5000"))
    (assert-eql 5000 (accept setting " 5000 "))
    (assert-eql 42 (accept setting 42))
    (assert-eq nil (accept setting ""))
    (assert-error 'settei:setting-invalid (accept setting "50OO"))
    (assert-error 'settei:setting-invalid (accept setting "port"))
    (assert-error 'settei:setting-invalid (accept setting 1.5))))

(define-test integer-bounds ()
  (let ((setting (make 'settei:integer-setting :minimum 1 :maximum 65535)))
    (assert-eql 1 (accept setting 1))
    (assert-eql 65535 (accept setting "65535"))
    (assert-error 'settei:setting-invalid (accept setting 0))
    (assert-error 'settei:setting-invalid (accept setting "70000"))
    (assert-eq nil (accept setting nil))))

(define-test the-message-completes-the-value ()
  (let ((condition (handler-case (accept (make 'settei:integer-setting :maximum 10) 11)
                     (settei:setting-invalid (condition) condition))))
    (assert-equal "is more than 10" (settei:settei-error-message condition))
    (assert-eql 11 (settei:setting-invalid-value condition))
    (assert-eq :t/example (settei:setting-invalid-name condition))))

(define-test string-and-pathname ()
  (assert-equal "hello" (accept (make 'settei:string-setting) "hello"))
  (assert-error 'settei:setting-invalid (accept (make 'settei:string-setting) 5))
  (assert-equal #p"/tmp/app.db" (accept (make 'settei:pathname-setting) "/tmp/app.db"))
  (assert-equal #p"db/" (accept (make 'settei:pathname-setting) #p"db/")))

(define-test choices ()
  (let ((setting (make 'settei:choice-setting :options '(:development :test :production))))
    (assert-eq :production (accept setting "production"))
    (assert-eq :production (accept setting "PRODUCTION"))
    (assert-eq :test (accept setting :test))
    (assert-error 'settei:setting-invalid (accept setting "staging"))
    (assert-error 'settei:setting-invalid (accept setting :staging)))
  (let ((setting (make 'settei:choice-setting
                       :options (lambda (configuration)
                                  (declare (ignore configuration))
                                  '("woo" "hunchentoot")))))
    (assert-equal "woo" (accept setting "WOO"))))

(define-test lists ()
  (let ((setting (make 'settei:list-setting)))
    (assert-equal '("almightylisp.com" "www.almightylisp.com")
                  (accept setting "almightylisp.com, www.almightylisp.com"))
    (assert-equal '("a" "b") (accept setting "a,,b,"))
    (assert-equal '("a") (accept setting '("a")))
    (assert-error 'settei:setting-invalid (accept setting '(1 2)))))

(define-test validators ()
  (let ((setting (make 'settei:string-setting
                       :validator (lambda (value configuration)
                                    (declare (ignore configuration))
                                    (unless (search "://" value)
                                      "has no scheme, like https://")))))
    (assert-equal "https://almightylisp.com" (accept setting "https://almightylisp.com"))
    (assert-equal "has no scheme, like https://"
                  (handler-case (accept setting "almightylisp.com")
                    (settei:setting-invalid (condition) (settei:settei-error-message condition))))))

(define-test any-type ()
  (let ((setting (make 'settei:setting :type '(member :woo :hunchentoot))))
    (assert-eq :woo (accept setting :woo))
    (assert-error 'settei:setting-invalid (accept setting :clack))))

(define-test labels-and-groups ()
  (let ((setting (make-instance 'settei:boolean-setting :name :magazine/desk-enabled)))
    (assert-equal "magazine" (settei:setting-group setting))
    (assert-equal "Desk enabled" (settei:setting-label setting)))
  (let ((setting (make-instance 'settei:boolean-setting :name :debug :group "server" :label "Debug")))
    (assert-equal "server" (settei:setting-group setting))
    (assert-equal "Debug" (settei:setting-label setting))))

(define-test rendering ()
  (assert-equal "true" (settei:render-value (make 'settei:boolean-setting) t))
  (assert-equal "false" (settei:render-value (make 'settei:boolean-setting) nil))
  (assert-equal ":production" (settei:render-value (make 'settei:choice-setting) :production))
  (assert-equal "a, b" (settei:render-value (make 'settei:list-setting) '("a" "b")))
  (assert-equal "(not set)" (settei:render-value (make 'settei:string-setting) nil)))
